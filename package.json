{
  "name": "token-generator",
  "homepage": "https://mtg.marquesgabriel.com.br",
  "version": "1.1.5",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.16",
    "@mui/material": "^5.15.15",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^16.18.91",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "bootstrap": "^5.3.8",
    "dom-to-image": "^2.6.0",
    "formik": "^2.4.9",
    "mana-font": "^1.15.9",
    "moment": "^2.30.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^6.2.3",
    "sass": "^1.72.0",
    "typescript": "^4.9.5",
    "web-vitals": "^6.1.1",
    "yup": "^1.4.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"*.{ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"*.{ts,html}\"",
    "commit": "git-cz",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@types/dom-to-image": "^2.6.7",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.1.1",
    "git-cz": "^4.9.0",
    "globals": "17.11.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
